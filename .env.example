# ---- Фронтенд (Vite) ----
# Базовый URL API. Оставь /api: локально Vite проксирует /api на dev-сервер
# Express (порт 3000), на Vercel это тот же домен, что и фронт.
VITE_API_URL=/api

# ---- Бэкенд / Prisma (Neon) ----
# Пул-соединение Neon (PgBouncer) — рантайм. Обычно содержит ?sslmode=require и хост *-pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Прямое соединение Neon — для миграций prisma. Хост без -pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
